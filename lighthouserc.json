{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/?console=snes"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02,
            "aggregationMethod": "median-run"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 2000000,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3200,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 400,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
