{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3100/", "http://localhost:3100/?console=snes"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median-run" }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3200, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 900, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
