# ---------------------------------------------------------------------------
# Zerei.app — integracao opcional com a IGDB (Twitch OAuth + IGDB API v4).
#
# O app roda 100% offline com a base local (data/seed-games.json).
# Preencha as duas variaveis abaixo somente se quiser habilitar a busca online
# em /api/igdb/search. Crie um app em https://dev.twitch.tv/console/apps
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Endereço público do site, usado nas prévias de link (og:image) do Gamer DNA.
# Ex.: https://zerei.app (quando o domínio existir) ou o *.workers.dev do deploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
