{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zerei",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Auto-referência exigida pelo cache do OpenNext; o nome casa com "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "zerei" }
  ],
  "images": {
    // Otimizador de imagens do next/image rodando no Cloudflare Images.
    "binding": "IMAGES"
  }
}
