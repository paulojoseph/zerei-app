{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zerei",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference required by the OpenNext cache; the name matches "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "zerei" }
  ],
  "images": {
    // next/image optimizer running on Cloudflare Images.
    "binding": "IMAGES"
  }
}
